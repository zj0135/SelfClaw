{
	"schemaVersion": 1,
	"id": "view-demo",
	"name": "View Demo",
	"version": "1.0.0",
	"description": "演示插件视图的两种摆放方式：右侧停靠面板，以及覆盖主窗口、按地标对齐并只在自己声明的矩形内接收指针的悬浮 HUD。",
	"publisher": "selfclaw",
	"permissions": [
		"ui.panel",
		"ui.floating",
		"host.context.read",
		"host.transcript.read",
		"host.composer.write"
	],
	"contributes": {
		"views": [
			{
				"id": "inspector",
				"slot": "right",
				"title": "视图演示",
				"icon": "layout-grid",
				"entry": "ui/dock.html",
				"defaultWidth": 420
			},
			{
				"id": "hud",
				"slot": "floating",
				"title": "悬浮 HUD",
				"icon": "layers",
				"entry": "ui/hud.html"
			}
		]
	}
}
