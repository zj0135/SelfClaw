<Window x:Class="SelfClaw.Desktop.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="192"
        Height="224"
        Title="SelfClaw Pet">
    <!--
        阶段2:spritesheet idle 行逐帧渲染。
        缺少 libwebp.dll 或素材加载失败时显示占位图形,避免浮窗启动崩溃。
    -->
    <Grid x:Name="PetRoot"
          Width="192"
          Height="224"
          Background="Transparent"
          MouseLeftButtonDown="OnPetMouseLeftButtonDown"
          MouseMove="OnPetMouseMove"
          MouseLeftButtonUp="OnPetMouseLeftButtonUp"
          LostMouseCapture="OnPetLostMouseCapture">
        <Image Source="{Binding CurrentFrame}"
               Width="192"
               Height="208"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               RenderOptions.BitmapScalingMode="{Binding BitmapScalingMode}" />

        <Border CornerRadius="16"
                Background="#CC2D2D3A"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Width="160"
                Height="176"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentFrame}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.5"
                                  Color="#000000" />
            </Border.Effect>
            <TextBlock Text="SC"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
