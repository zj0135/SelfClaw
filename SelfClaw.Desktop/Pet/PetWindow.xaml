<Window x:Class="SelfClaw.Desktop.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="192"
        Height="112"
        Title="SelfClaw Pet">
    <!--
        阶段3:spritesheet 动画 + hover/drag/waiting 交互状态。
        缺少 libwebp.dll 或素材加载失败时显示占位图形,避免浮窗启动崩溃。
    -->
    <Grid x:Name="PetRoot"
          Width="192"
          Height="112"
          Background="Transparent"
          MouseLeftButtonDown="OnPetMouseLeftButtonDown"
          MouseMove="OnPetMouseMove"
          MouseLeftButtonUp="OnPetMouseLeftButtonUp"
          LostMouseCapture="OnPetLostMouseCapture"
          MouseEnter="OnPetMouseEnter"
          MouseLeave="OnPetMouseLeave">
        <Image Source="{Binding CurrentFrame}"
               Width="192"
               Height="104"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               RenderOptions.BitmapScalingMode="{Binding BitmapScalingMode}" />

        <Border CornerRadius="8"
                Background="#CC2D2D3A"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Width="160"
                Height="88"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentFrame}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.5"
                                  Color="#000000" />
            </Border.Effect>
            <TextBlock Text="SC"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <Border IsHitTestVisible="False"
                Background="#F2FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBubbleVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding BubbleText}"
                       Foreground="#E6000000"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
