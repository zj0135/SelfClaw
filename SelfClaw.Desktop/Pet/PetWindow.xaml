<Window x:Class="SelfClaw.Desktop.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="SelfClaw Pet">
    <!--
        阶段1:静态浮窗 + 拖拽 + 位置持久化。
        视觉先用占位图形(圆角矩形 + 文字),真正的 spritesheet 帧渲染留给阶段2。
        窗口尺寸略大于精灵单格(192×208),给拖影/气泡留余量。
    -->
    <Grid x:Name="PetRoot"
          Width="160"
          Height="176"
          Background="Transparent"
          MouseLeftButtonDown="OnPetMouseLeftButtonDown"
          MouseMove="OnPetMouseMove"
          MouseLeftButtonUp="OnPetMouseLeftButtonUp"
          LostMouseCapture="OnPetLostMouseCapture">
        <Border CornerRadius="16"
                Background="#CC2D2D3A"
                BorderBrush="#66FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.5"
                                  Color="#000000" />
            </Border.Effect>
            <TextBlock Text="🐾"
                       FontSize="56"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
