<Window x:Class="SelfClaw.Desktop.Notifications.DesktopNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfClaw Notification"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="NotificationActionButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="82"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="Foreground"
                    Value="#FFF7FBFF"/>
            <Setter Property="Background"
                    Value="#334B5D7A"/>
            <Setter Property="BorderBrush"
                    Value="#445F7BA5"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Opacity"
                                        Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Padding="16"
            Background="#F5141A24"
            BorderBrush="#3AF6FAFF"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.36"
                              Color="#FF000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,32,0">
                <TextBlock x:Name="TitleTextBlock"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFF8FBFF"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageTextBlock"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#DDE5F2"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Row="0"
                    Style="{StaticResource TrafficLightButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="#FF5F57"
                    Click="OnDismissButtonClick">
                <Grid Width="7.5"
                      Height="7.5">
                    <Path Style="{StaticResource TrafficGlyphPathStyle}"
                          Data="M1,1 L6,6 M6,1 L1,6"/>
                </Grid>
            </Button>

            <Grid x:Name="ReplyPanel"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ReplyTextBox"
                         MinHeight="30"
                         Padding="8,5"
                         Margin="0,0,6,0"
                         FontSize="11"
                         VerticalContentAlignment="Center"
                         TextChanged="OnReplyTextBoxTextChanged"
                         KeyDown="OnReplyTextBoxKeyDown"/>

                <Button x:Name="ReplyButton"
                        Grid.Column="1"
                        MinWidth="56"
                        MinHeight="30"
                        Padding="10,4"
                        Margin="0"
                        FontSize="11"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentHoverBrush}"
                        Click="OnReplyButtonClick"
                        Content="Send"
                        IsEnabled="False"/>
            </Grid>

            <StackPanel x:Name="ActionPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                <Button x:Name="SecondaryActionButton"
                        Style="{StaticResource NotificationActionButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnSecondaryActionButtonClick"/>
                <Button x:Name="PrimaryActionButton"
                        Style="{StaticResource NotificationActionButtonStyle}"
                        Margin="0"
                        Background="#FF6BC6FF"
                        BorderBrush="#FF85D0FF"
                        Foreground="#FF102133"
                        Visibility="Collapsed"
                        Click="OnPrimaryActionButtonClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
