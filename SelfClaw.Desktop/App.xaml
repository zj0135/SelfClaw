<Application x:Class="SelfClaw.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <CornerRadius x:Key="ShellCornerRadius">28</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">22</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadius">16</CornerRadius>

        <SolidColorBrush x:Key="WindowCanvasBrush" Color="#06080B" />
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="#1A2029" />
        <SolidColorBrush x:Key="PanelFillBrush" Color="#0C1015" />
        <SolidColorBrush x:Key="PanelFillStrongBrush" Color="#11161D" />
        <SolidColorBrush x:Key="ControlFillBrush" Color="#0E1319" />
        <SolidColorBrush x:Key="ControlFillMutedBrush" Color="#10141A" />
        <SolidColorBrush x:Key="ControlStrokeBrush" Color="#212A35" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#8C95A3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5D8BFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#78A1FF" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#4365C8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#1ED760" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5D8BFF" />
            <GradientStop Offset="1" Color="#63C6FF" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#0A0D12" />
            <GradientStop Offset="1" Color="#090B10" />
        </LinearGradientBrush>

        <Style TargetType="FrameworkElement">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        </Style>

        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelFillBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource PanelFillStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#171D25" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0D1117" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#10161E" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#10161E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <SolidColorBrush x:Key="TrafficGlyphBrush" Color="#8A1A1F2A" />

        <Style x:Key="TrafficLightButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="15" />
            <Setter Property="Height"
                    Value="15" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="#4A000000" />
            <Setter Property="Background"
                    Value="#FF5F57" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Ellipse x:Name="Circle"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter x:Name="GlyphHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0.75" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Circle"
                                        Property="Opacity"
                                        Value="0.82" />
                                <Setter TargetName="GlyphHost"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Circle"
                                        Property="Opacity"
                                        Value="0.38" />
                                <Setter TargetName="GlyphHost"
                                        Property="Opacity"
                                        Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrafficGlyphPathStyle"
               TargetType="Path">
            <Setter Property="Stroke"
                    Value="{DynamicResource TrafficGlyphBrush}" />
            <Setter Property="StrokeThickness"
                    Value="1.2" />
            <Setter Property="StrokeStartLineCap"
                    Value="Round" />
            <Setter Property="StrokeEndLineCap"
                    Value="Round" />
            <Setter Property="SnapsToDevicePixels"
                    Value="True" />
        </Style>
    </Application.Resources>
</Application>
