<UserControl x:Class="SelfClaw.Desktop.Controls.TerminalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="268"
             d:DesignWidth="430"
             Background="Transparent">
    <Border Background="#FFFFFF"
            BorderBrush="#D8DDE6"
            BorderThickness="0,1,0,0"
            CornerRadius="0"
            SnapsToDevicePixels="True">
        <Border.Resources>
            <Style x:Key="TerminalCloseButtonStyle"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="28"/>
                <Setter Property="Height"
                        Value="28"/>
                <Setter Property="MinHeight"
                        Value="28"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderBrush"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Focusable"
                        Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#EEF2F7"/>
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <Path Width="15"
                          Height="15"
                          VerticalAlignment="Center"
                          Stroke="#111827"
                          StrokeThickness="1.35"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"
                          Data="M2.5,3.5 L13.5,3.5 L13.5,12.5 L2.5,12.5 Z M5,6.5 L7.2,8 L5,9.5 M8.5,9.7 L11,9.7"/>

                    <TextBlock Grid.Column="1"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#111827"
                               FontFamily="Segoe UI Variable Text"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="终端"/>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Text="PowerShell"/>

                    <Button Grid.Column="3"
                            Margin="4,0,0,0"
                            Style="{StaticResource TerminalCloseButtonStyle}"
                            ToolTip="Close terminal"
                            Click="OnCloseButtonClick">
                        <Path Width="11"
                              Height="11"
                              Stroke="#374151"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2,2 L9,9 M9,2 L2,9"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="14,12,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Foreground="#6B7280"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Text="Windows PowerShell"/>

                <TextBlock Grid.Row="1"
                           Margin="0,7,0,0"
                           Foreground="#374151"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Text="PS D:\Repositories\SelfClaw&gt;"/>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="5">
                    <TextBlock Margin="10"
                               Foreground="#9CA3AF"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Text="终端布局占位，功能稍后接入。"/>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="14,8,14,12"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="#374151"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Text="&gt;"/>

                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Text="输入区域占位"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
