<UserControl x:Class="SelfClaw.Desktop.Controls.SystemSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="980"
             Loaded="OnLoadedAsync"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="SettingsTextBrush"
                         Color="#111827"/>
        <SolidColorBrush x:Key="SettingsMutedBrush"
                         Color="#6B7280"/>
        <SolidColorBrush x:Key="SettingsSubtleBrush"
                         Color="#9CA3AF"/>
        <SolidColorBrush x:Key="SettingsBorderBrush"
                         Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SettingsSelectedBrush"
                         Color="#ECECF0"/>
        <SolidColorBrush x:Key="SettingsSoftBrush"
                         Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SettingsAccentBrush"
                         Color="#111827"/>

        <Style x:Key="SettingsIconPathStyle"
               TargetType="Path">
            <Setter Property="Stroke"
                    Value="#6B7280"/>
            <Setter Property="StrokeThickness"
                    Value="1.45"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>

        <Style x:Key="SettingsSectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsSubtleBrush}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Margin"
                    Value="10,18,0,6"/>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#D8DDE6"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#A7ADB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Padding"
                    Value="14,0"/>
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2F3F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F3F4F6"/>
                                <Setter Property="Foreground"
                                        Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SettingsBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="18,0"/>
            <Setter Property="Background"
                    Value="#111827"/>
            <Setter Property="BorderBrush"
                    Value="#111827"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Foreground"
                    Value="#FFFFFF"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#9CA3AF"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderRowButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,1"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2F3F6"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource SettingsSelectedBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Width"
                    Value="42"/>
            <Setter Property="Height"
                    Value="24"/>
            <Setter Property="Background"
                    Value="#D1D5DB"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="42"
                                Height="24"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#111827"/>
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProviderRowTemplate">
            <Button Style="{StaticResource ProviderRowButtonStyle}"
                    Command="{Binding DataContext.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#F3F4F6"
                            CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Text="{Binding IconText}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SettingsTextBrush}"
                               FontSize="13"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"/>
                    <Ellipse Grid.Column="2"
                             Width="5"
                             Height="5"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Fill="#10B981"
                             Visibility="{Binding IsProviderEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ModelRowTemplate">
            <Border BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            Background="#F3F4F6"
                            CornerRadius="16">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding Badge}"/>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="8,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}"/>
                            <Border Margin="8,0,0,0"
                                    Padding="7,2"
                                    Background="#F4F5F7"
                                    CornerRadius="9">
                                <TextBlock Foreground="#6B7280"
                                           FontSize="10"
                                           Text="{Binding ModelId}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   Text="{Binding ContextText}"/>
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#10A37F"
                                   FontSize="11"
                                   Text="{Binding CacheText}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource SwitchToggleStyle}"
                                  IsChecked="{Binding IsModelEnabled}"
                                  Command="{Binding DataContext.ToggleModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="14,24,22,18">
                    <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="设置"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource SettingsMutedBrush}"
                               FontSize="12"
                               Text="偏好与模型设置"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,0,14,0">
                    <StackPanel>
                        <Grid Height="40"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,12.5 L3,7.5 M8,12.5 L8,3.5 M13,12.5 L13,5.5 M2,12.5 L14,12.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="数据统计"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="系统"/>
                        <Grid Height="40"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,4 L13,4 L13,12 L3,12 Z M5,6.5 L7,8 L5,9.5 M8.5,9.5 L11,9.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="系统设置"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="AI 能力"/>
                        <Border Height="40"
                                Margin="0,2,0,0"
                                Background="{StaticResource SettingsSelectedBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="#111827"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M3,4 L13,4 L13,7 L3,7 Z M3,10 L13,10 L13,13 L3,13 Z M5,5.5 L5.05,5.5 M5,11.5 L5.05,11.5"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="AI 服务商"/>
                            </Grid>
                        </Border>

                        <Grid Height="40"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.5 L13,5.2 L8,8 L3,5.2 Z M3,8 L8,10.8 L13,8 M3,10.8 L8,13.5 L13,10.8"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="模型管理"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="扩展与集成"/>
                        <Grid Height="40"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,4 L13,4 L13,12 L3,12 Z M5,6.5 L7,8 L5,9.5 M8.5,9.5 L11,9.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="MCP 服务器"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="关于"/>
                        <Grid Height="40"
                              Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.5 C5,2.5 2.5,5 2.5,8 C2.5,11 5,13.5 8,13.5 C11,13.5 13.5,11 13.5,8 C13.5,5 11,2.5 8,2.5 Z M8,7.3 L8,11 M8,5 L8.05,5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="关于"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Margin="14,0,0,18"
                           Foreground="#B0B7C3"
                           FontSize="11"
                           Text="Powered by SelfClaw"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="26,22,28,14">
                <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="AI 服务商"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource SettingsMutedBrush}"
                           FontSize="13"
                           Text="为每个服务商配置 API Key 和模型"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="{StaticResource SettingsBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="34"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <Grid>
                                    <Path Width="13"
                                          Height="13"
                                          Margin="12,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Stroke="#9CA3AF"
                                          StrokeThickness="1.45"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="M5.8,10.2 C3.5,10.2 1.8,8.5 1.8,6.2 C1.8,3.9 3.5,2.2 5.8,2.2 C8.1,2.2 9.8,3.9 9.8,6.2 C9.8,8.5 8.1,10.2 5.8,10.2 Z M9,9 L11.5,11.5"/>
                                    <TextBox Margin="30,0,8,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontSize="12"
                                             Foreground="{StaticResource SettingsTextBrush}"
                                             Text="{Binding ProviderSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Margin="30,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#9CA3AF"
                                               FontSize="12"
                                               IsHitTestVisible="False"
                                               Text="搜索服务商...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProviderSearchText}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding OpenAddProviderDialogCommand}"
                                    ToolTip="添加服务商">
                                <Path Width="12"
                                      Height="12"
                                      Stroke="#6B7280"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M6,1.5 L6,10.5 M1.5,6 L10.5,6"/>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,0,8,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                           Margin="0,0,0,6"
                                           Text="已启用"/>
                                <ItemsControl ItemsSource="{Binding EnabledProviders}"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}"/>

                                <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                           Margin="0,16,0,6"
                                           Text="已禁用"
                                           Visibility="{Binding HasDisabledProviders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding DisabledProviders}"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}"
                                              Visibility="{Binding HasDisabledProviders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,6,28,28">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    Background="#F3F4F6"
                                    CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#111827"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedProvider.IconText}"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedProvider.Name}"/>
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource SettingsMutedBrush}"
                                           FontSize="12"
                                           Text="{Binding SelectedProvider.ProtocolLabel}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggleStyle}"
                                          IsChecked="{Binding SelectedProvider.IsProviderEnabled}"
                                          Command="{Binding ToggleSelectedProviderEnabledCommand}"/>
                        </Grid>

                        <Border Height="1"
                                Margin="0,0,0,20"
                                Background="{StaticResource SettingsBorderBrush}"/>

                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="API Key"/>
                        <Grid Margin="0,8,0,16">
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding SelectedProvider.ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnAutoSaveLostFocus"/>
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stroke="#6B7280"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  IsHitTestVisible="False"
                                  Data="M1.8,7 C3.1,4.8 4.9,3.7 7,3.7 C9.1,3.7 10.9,4.8 12.2,7 C10.9,9.2 9.1,10.3 7,10.3 C4.9,10.3 3.1,9.2 1.8,7 Z M7,5.4 C6.1,5.4 5.4,6.1 5.4,7 C5.4,7.9 6.1,8.6 7,8.6 C7.9,8.6 8.6,7.9 8.6,7 C8.6,6.1 7.9,5.4 7,5.4 Z"/>
                        </Grid>

                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="API 代理地址"/>
                        <TextBox Margin="0,8,0,8"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SelectedProvider.EndpointText, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="OnAutoSaveLostFocus"/>
                        <TextBlock Margin="1,0,0,18"
                                   Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="11"
                                   Text="自定义端点，用于代理或第三方兼容服务"/>

                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="连通性检查"/>
                        <Grid Margin="0,8,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Height="36"
                                      Padding="10,0"
                                      BorderBrush="#D8DDE6"
                                      FontSize="12"
                                      ItemsSource="{Binding VisibleModels}"
                                      DisplayMemberPath="ModelId"
                                      SelectedItem="{Binding SelectedConnectivityModel}"/>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PillButtonStyle}"
                                    Command="{Binding CheckConnectivityCommand}"
                                    Content="检查"/>
                        </Grid>
                        <TextBlock Margin="1,-12,0,20"
                                   Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="11"
                                   Text="{Binding ConnectionStatusText}"/>

                        <Border Padding="14,14"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="模型列表"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource SettingsMutedBrush}"
                                                   FontSize="11"
                                                   Text="{Binding ModelSummaryText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            BorderBrush="{StaticResource SettingsBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ModelCountBadge}"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Height="32"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource SettingsBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Path Width="13"
                                                  Height="13"
                                                  Margin="12,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Stroke="#9CA3AF"
                                                  StrokeThickness="1.45"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Data="M5.8,10.2 C3.5,10.2 1.8,8.5 1.8,6.2 C1.8,3.9 3.5,2.2 5.8,2.2 C8.1,2.2 9.8,3.9 9.8,6.2 C9.8,8.5 8.1,10.2 5.8,10.2 Z M9,9 L11.5,11.5"/>
                                            <TextBox Margin="30,0,8,0"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="12"
                                                     Foreground="{StaticResource SettingsTextBrush}"
                                                     Text="{Binding ModelSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Margin="30,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#9CA3AF"
                                                       FontSize="12"
                                                       IsHitTestVisible="False"
                                                       Text="搜索模型">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ModelSearchText}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding EnableAllModelsCommand}"
                                            Content="全部启用"/>
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding DisableAllModelsCommand}"
                                            Content="全部禁用"/>
                                    <Button Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding RefreshModelsCommand}"
                                            Content="获取模型列表"/>
                                    <Button Grid.Column="4"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding AddModelCommand}"
                                            ToolTip="添加模型">
                                        <Path Width="12"
                                              Height="12"
                                              Stroke="#111827"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M6,1.5 L6,10.5 M1.5,6 L10.5,6"/>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding VisibleModels}"
                                              ItemTemplate="{StaticResource ModelRowTemplate}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,12,0,0"
                                   Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="11"
                                   Text="{Binding AutoSaveStatusText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="20"
              Visibility="{Binding IsAddProviderDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#66000000"/>
            <Border Width="510"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="添加自定义服务商"/>
                            <TextBlock Margin="0,6,0,20"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="13"
                                       Text="添加一个 OpenAI 兼容或 Anthropic 协议的自定义 AI 服务商"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CancelAddProviderCommand}">
                            <Path Width="12"
                                  Height="12"
                                  Stroke="#111827"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M2,2 L10,10 M10,2 L2,10"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="服务商名称"/>
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="协议类型"/>
                        <ComboBox Width="266"
                                  Height="36"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Left"
                                  Padding="10,0"
                                  FontSize="12"
                                  ItemsSource="{Binding AddProtocolOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedAddProtocol}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,24">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Base URL"/>
                        <TextBox Margin="0,8,0,8"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding NewProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="11"
                                   Text="API 接口的基础地址"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource PillButtonStyle}"
                                BorderThickness="0"
                                Command="{Binding CancelAddProviderCommand}"
                                Content="取消"/>
                        <Button Margin="12,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddProviderCommand}"
                                IsEnabled="{Binding CanAddProvider}"
                                Content="添加"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
