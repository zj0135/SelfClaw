                                  Stroke="#111827"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M2,2 L10,10 M10,2 L2,10"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="服务商名称"/>
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="协议类型"/>
                        <ComboBox Width="266"
                                  Height="36"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Left"
                                  Padding="10,0"
                                  FontSize="12"
                                  ItemsSource="{Binding AddProtocolOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedAddProtocol}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,24">
                        <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Base URL"/>
                        <TextBox Margin="0,8,0,8"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding NewProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="11"
                                   Text="API 接口的基础地址"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource PillButtonStyle}"
                                BorderThickness="0"
                                Command="{Binding CancelAddProviderCommand}"
                                Content="取消"/>
                        <Button Margin="12,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddProviderCommand}"
                                IsEnabled="{Binding CanAddProvider}"
                                Content="添加"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
