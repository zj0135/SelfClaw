<UserControl x:Class="SelfClaw.Desktop.Controls.SystemSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="980"
             Background="#FFFFFF">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsTextBrush"
                         Color="#111827"/>
        <SolidColorBrush x:Key="SettingsMutedBrush"
                         Color="#6B7280"/>
        <SolidColorBrush x:Key="SettingsSubtleBrush"
                         Color="#9CA3AF"/>
        <SolidColorBrush x:Key="SettingsBorderBrush"
                         Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SettingsSelectedBrush"
                         Color="#ECECF0"/>

        <Style x:Key="SettingsIconPathStyle"
               TargetType="Path">
            <Setter Property="Stroke"
                    Value="#6B7280"/>
            <Setter Property="StrokeThickness"
                    Value="1.45"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>

        <Style x:Key="SettingsNavItemStyle"
               TargetType="Grid">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Margin"
                    Value="0,2,0,0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#F2F3F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SettingsSubtleBrush}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Margin"
                    Value="10,18,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="14,24,22,18">
                    <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="设置"/>
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource SettingsMutedBrush}"
                               FontSize="12"
                               Text="偏好与模型设置"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,0,14,0">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,12.5 L3,7.5 M8,12.5 L8,3.5 M13,12.5 L13,5.5 M2,12.5 L14,12.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="数据统计"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M4,5 L12,5 M4,5 L6.5,2.5 M4,5 L6.5,7.5 M12,11 L4,11 M12,11 L9.5,8.5 M12,11 L9.5,13.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="迁移中心"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="系统"/>

                        <Border Height="40"
                                Margin="0,2,0,0"
                                Background="{StaticResource SettingsSelectedBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="#111827"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M3,4 L13,4 L13,12 L3,12 Z M5,6.5 L7,8 L5,9.5 M8.5,9.5 L11,9.5"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="系统设置"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="AI 能力"/>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,4 L13,4 L13,7 L3,7 Z M3,10 L13,10 L13,13 L3,13 Z M5,5.5 L5.05,5.5 M5,11.5 L5.05,11.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="AI 服务商"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.5 L13,5.2 L8,8 L3,5.2 Z M3,8 L8,10.8 L13,8 M3,10.8 L8,13.5 L13,10.8"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="模型管理"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.5 L9.2,4 L11,3.6 L11.6,5.4 L13.2,6.2 L12.7,8 L13.8,9.4 L12.4,10.6 L12.4,12.4 L10.6,12.8 L9.6,14 L8,13.2 L6.4,14 L5.4,12.8 L3.6,12.4 L3.6,10.6 L2.2,9.4 L3.3,8 L2.8,6.2 L4.4,5.4 L5,3.6 L6.8,4 Z"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="模型配置"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="扩展与集成"/>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M6,2.5 L6,5.5 M10,2.5 L10,5.5 M4.5,5.5 L11.5,5.5 L11.5,8.5 C11.5,10.4 9.9,12 8,12 C6.1,12 4.5,10.4 4.5,8.5 Z M8,12 L8,14"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="插件"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,4 L13,4 L13,12 L3,12 Z M5,6.5 L7,8 L5,9.5 M8.5,9.5 L11,9.5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="MCP 服务器"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.2 C4.8,2.2 2.2,4.8 2.2,8 C2.2,11.2 4.8,13.8 8,13.8 C11.2,13.8 13.8,11.2 13.8,8 C13.8,4.8 11.2,2.2 8,2.2 Z M2.5,8 L13.5,8 M8,2.4 C9.25,3.9 10,5.8 10,8 C10,10.2 9.25,12.1 8,13.6 M8,2.4 C6.75,3.9 6,5.8 6,8 C6,10.2 6.75,12.1 8,13.6"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="联网搜索"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M3,12 L4.8,8.4 L10.5,2.7 C11,2.2 11.8,2.2 12.3,2.7 L13.3,3.7 C13.8,4.2 13.8,5 13.3,5.5 L7.6,11.2 Z M9.6,3.6 L12.4,6.4 M4.5,4 L4.55,4 M2.5,6.5 L2.55,6.5 M11.5,12 L11.55,12"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="技能市场"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingsSectionLabelStyle}"
                                   Text="关于"/>

                        <Grid Style="{StaticResource SettingsNavItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsIconPathStyle}"
                                  Data="M8,2.5 C5,2.5 2.5,5 2.5,8 C2.5,11 5,13.5 8,13.5 C11,13.5 13.5,11 13.5,8 C13.5,5 11,2.5 8,2.5 Z M8,7.3 L8,11 M8,5 L8.05,5"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="14"
                                       Text="关于"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Margin="14,0,0,18"
                           Foreground="#B0B7C3"
                           FontSize="11"
                           Text="Powered by SelfClaw"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="72,58,72,72"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="系统设置"/>
                    <TextBlock Margin="0,5,0,34"
                               Foreground="{StaticResource SettingsMutedBrush}"
                               FontSize="14"
                               Text="Shell 运行时、代理与系统级执行偏好"/>

                    <Border Padding="16,18"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Shell 执行端"/>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="12"
                                       Text="选择 SelfClaw 在工具调用中使用哪个 shell。可选项会根据当前操作系统过滤。"/>

                            <Border Margin="0,10,0,16"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Background="#F4F5F7"
                                    CornerRadius="10">
                                <TextBlock Foreground="{StaticResource SettingsTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="当前系统：win32"/>
                            </Border>

                            <Border Height="36"
                                    BorderBrush="#D8DDE6"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               FontSize="13"
                                               Text="自动（系统默认）"/>
                                    <Path Grid.Column="1"
                                          Width="9"
                                          Height="5"
                                          VerticalAlignment="Center"
                                          Stroke="#9CA3AF"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M1,1 L4.5,4 L8,1"/>
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,10,0,14"
                                       Foreground="{StaticResource SettingsMutedBrush}"
                                       FontSize="12"
                                       Text="使用应用默认解析：macOS/Linux 优先 SHELL/zsh/bash/sh，Windows 使用系统命令 shell。"/>

                            <Border Height="34"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsMutedBrush}"
                                           FontSize="12"
                                           Text="当前解析：自动，将在执行时选择"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,36,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="系统代理"/>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,6,0,10"
                                   Foreground="{StaticResource SettingsMutedBrush}"
                                   FontSize="12"
                                   Text="设置整个应用进程使用的代理地址，例如 http://127.0.0.1:7890 或 http://host:port。"/>

                        <Border Grid.Row="2"
                                Height="36"
                                BorderBrush="#D8DDE6"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"
                                       FontSize="13"
                                       Text="http://127.0.0.1:7890"/>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="恢复默认"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
