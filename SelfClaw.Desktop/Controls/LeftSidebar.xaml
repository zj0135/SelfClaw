                    </Grid>
                    <TextBlock Grid.Column="1"
                               Margin="0,0,0,1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="Settings"/>
                </Grid>

                <TextBlock Grid.Column="2"
                           Margin="8,0,2,1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10.5"
