<UserControl x:Class="SelfClaw.Desktop.Controls.LeftSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SelfClaw.Desktop.Services"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="280"
             Background="#F4F5F7">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarBackgroundBrush"
                         Color="#F4F5F7"/>
        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#0B0F19"/>
        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#8A929E"/>
        <SolidColorBrush x:Key="DividerBrush"
                         Color="#E7E9EE"/>
        <SolidColorBrush x:Key="IconBrush"
                         Color="#111827"/>
        <SolidColorBrush x:Key="SubtleIconBrush"
                         Color="#8B94A1"/>
        <SolidColorBrush x:Key="BadgeFillBrush"
                         Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BadgeStrokeBrush"
                         Color="#E0E4EA"/>
        <SolidColorBrush x:Key="DangerTextBrush"
                         Color="#E11D48"/>
        <services:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SidebarIconPathStyle"
               TargetType="Path">
            <Setter Property="Stroke"
                    Value="{StaticResource IconBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="1.45"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>

        <Style x:Key="SidebarSubtleIconPathStyle"
               TargetType="Path"
               BasedOn="{StaticResource SidebarIconPathStyle}">
            <Setter Property="Stroke"
                    Value="{StaticResource SubtleIconBrush}"/>
        </Style>

        <Style x:Key="NavTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="SectionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="Medium"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="MutedLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionLabelStyle}">
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="26"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="MinHeight"
                    Value="26"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E9ECF2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#DEE3EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNodeGridStyle"
               TargetType="Grid">
            <Setter Property="Height"
                    Value="36"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E9ECF2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNodeButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="MinHeight"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E9ECF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSelectableNodeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarNodeButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E9ECF2"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E2E8F0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarConversationRowStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E9ECF2"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="Background"
                            Value="#E2E8F0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarConversationSelectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarNodeButtonStyle}">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarConversationDeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="MinHeight"
                    Value="28"/>
            <Setter Property="Margin"
                    Value="4,0,0,0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Right"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="ToolTip"
                    Value="Delete chat"/>
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#EEF2F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="Width"
                    Value="206"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#DDE1E8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="HasDropShadow"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="0,6">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Margin="5,0"
                                Background="Transparent"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectDangerMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource ProjectMenuItemStyle}">
            <Setter Property="Foreground"
                    Value="{StaticResource DangerTextBrush}"/>
        </Style>

        <Style x:Key="ProjectMenuSeparatorStyle"
               TargetType="Separator">
            <Setter Property="Margin"
                    Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{StaticResource DividerBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarAnimatedGroupContentBaseStyle"
               TargetType="Border">
            <Setter Property="ClipToBounds"
                    Value="True"/>
            <Setter Property="Opacity"
                    Value="0"/>
            <Setter Property="MaxHeight"
                    Value="0"/>
        </Style>

        <Style x:Key="SidebarProjectsGroupContentStyle"
               TargetType="Border"
               BasedOn="{StaticResource SidebarAnimatedGroupContentBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarProjectsExpanded}"
                             Value="True">
                    <Setter Property="Opacity"
                            Value="1"/>
                    <Setter Property="MaxHeight"
                            Value="2000"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="2000"
                                                 Duration="0:0:0.16"
                                                 DecelerationRatio="0.85"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="0"
                                                 Duration="0:0:0.14"
                                                 DecelerationRatio="0.85"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.10"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarStandaloneGroupContentStyle"
               TargetType="Border"
               BasedOn="{StaticResource SidebarAnimatedGroupContentBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarStandaloneConversationsExpanded}"
                             Value="True">
                    <Setter Property="Opacity"
                            Value="1"/>
                    <Setter Property="MaxHeight"
                            Value="2000"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="2000"
                                                 Duration="0:0:0.16"
                                                 DecelerationRatio="0.85"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="0"
                                                 Duration="0:0:0.14"
                                                 DecelerationRatio="0.85"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.10"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SidebarBackgroundBrush}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="34"
                  Margin="8,2,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Width="18"
                      Height="18"
                      Margin="8,4,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path Style="{StaticResource SidebarIconPathStyle}"
                          Data="M3,3 L12.5,3 L12.5,12.5 L3,12.5 Z M6.7,5.5 L4.8,7.8 L6.7,10.1 M8.8,5.5 L10.7,7.8 L8.8,10.1"/>
                </Grid>

                <TextBlock Grid.Column="1"
                           Margin="8,8,0,8"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="SelfClaw"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="8,6,8,0">
                <Grid Style="{StaticResource SidebarNodeGridStyle}"
                      MouseLeftButtonUp="OnNewConversationNodeMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconPathStyle}"
                              Data="M2.5,3.5 L11.5,3.5 C12.3,3.5 13,4.2 13,5 L13,9.5 C13,10.3 12.3,11 11.5,11 L8,11 L4.5,13.5 L4.5,11 L2.5,11 C1.7,11 1,10.3 1,9.5 L1,5 C1,4.2 1.7,3.5 2.5,3.5 Z"/>
                        <Path Stroke="{StaticResource IconBrush}"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M7,1.5 L7,3.5 M4.5,2 L9.5,2"/>
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource NavTextStyle}"
                               Text="New chat"/>
                </Grid>

                <Grid Style="{StaticResource SidebarNodeGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Style="{StaticResource SidebarIconPathStyle}"
                          Data="M7,2.5 C4.5,2.5 2.5,4.5 2.5,7 C2.5,9.5 4.5,11.5 7,11.5 C9.5,11.5 11.5,9.5 11.5,7 C11.5,4.5 9.5,2.5 7,2.5 Z M10.4,10.4 L13.5,13.5"/>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource NavTextStyle}"
                               Text="Search"/>
                </Grid>

                <Grid x:Name="ExtensionsNode"
                      Style="{StaticResource SidebarNodeGridStyle}"
                      MouseLeftButtonUp="OnExtensionsNodeMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path Style="{StaticResource SidebarIconPathStyle}"
                              Data="M5.2,2 L10.8,2 L10.8,5.2 L14,5.2 L14,10.8 L10.8,10.8 L10.8,14 L5.2,14 L5.2,10.8 L2,10.8 L2,5.2 L5.2,5.2 Z"/>
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource NavTextStyle}"
                               Text="Extensions"/>
                    <Path x:Name="ExtensionsChevron"
                          Grid.Column="2"
                          Width="6"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          Style="{StaticResource SidebarIconPathStyle}"
                          Data="M2,1.5 L5.5,5 L2,8.5"/>
                </Grid>

                <StackPanel x:Name="ExtensionsChildren"
                            Margin="28,2,0,4"
                            Visibility="Collapsed">
                    <Grid Style="{StaticResource SidebarNodeGridStyle}"
                          Height="30">
                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="MCP servers"/>
                    </Grid>
                    <Grid Style="{StaticResource SidebarNodeGridStyle}"
                          Height="30">
                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Skills"/>
                    </Grid>
                    <Grid Style="{StaticResource SidebarNodeGridStyle}"
                          Height="30">
                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Tools"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="8,11,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Cursor="Hand"
                              MouseLeftButtonUp="OnProjectsHeaderMouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="8"
                                  Height="10"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="M2,1.5 L5.5,5 L2,8.5">
                                <Path.Style>
                                    <Style TargetType="Path"
                                           BasedOn="{StaticResource SidebarSubtleIconPathStyle}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarProjectsExpanded}"
                                                         Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Text="Projects"/>
                            <Border Grid.Column="2"
                                    MinWidth="15"
                                    Height="19"
                                    Margin="6,0,0,0"
                                    Padding="4,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BadgeFillBrush}"
                                    BorderBrush="{StaticResource BadgeStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="{Binding SidebarProjectCount}"/>
                            </Border>

                            <Button Grid.Column="4"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnProjectsImportButtonClick">
                                <Path Width="14"
                                      Height="14"
                                      Style="{StaticResource SidebarIconPathStyle}"
                                      Data="M8,2.1 L8,9.5 M5.2,4.8 L8,2.1 L10.8,4.8 M3,11.5 L3,13.6 L13,13.6 L13,11.5"/>
                            </Button>

                            <Button Grid.Column="5"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OnProjectsAddButtonClick">
                                <Path Width="13"
                                      Height="13"
                                      Style="{StaticResource SidebarIconPathStyle}"
                                      Data="M6.5,1.8 L6.5,11.2 M1.8,6.5 L11.2,6.5"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource SidebarProjectsGroupContentStyle}">
                            <ItemsControl ItemsSource="{Binding SidebarProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,2">
                                            <Grid Height="34"
                                                  Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.ColumnSpan="2"
                                                        Style="{StaticResource SidebarNodeButtonStyle}"
                                                        Tag="{Binding Id}"
                                                        ToolTip="{Binding RootPath}"
                                                        Click="OnProjectButtonClick">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Path Width="15"
                                                              Height="13"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Style="{StaticResource SidebarSubtleIconPathStyle}"
                                                              Data="M1.7,5.1 L5.1,5.1 L6.3,6.8 L14,6.8 L14,12.4 L1.7,12.4 Z M1.7,5.1 L1.7,3.6 L5.8,3.6 L7.1,5.1 L14,5.1"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Style="{StaticResource NavTextStyle}"
