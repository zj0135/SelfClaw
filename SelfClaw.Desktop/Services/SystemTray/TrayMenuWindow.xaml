<Window x:Class="SelfClaw.Desktop.Services.SystemTray.TrayMenuWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Title="SelfClaw Tray Menu">
    <Grid Margin="12">
        <Border x:Name="CardBorder"
                Width="236"
                CornerRadius="10"
                BorderThickness="1"
                Padding="6"
                Background="#F3F3F5"
                BorderBrush="#E5E7EB">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.18"
                                  Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <!-- 第一行：显示宠物与开关 -->
                <Border x:Name="PetRow"
                        CornerRadius="6"
                        Height="36"
                        Padding="8,0"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseEnter="OnItemMouseEnter"
                        MouseLeave="OnItemMouseLeave"
                        MouseLeftButtonUp="OnPetRowClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 宠物爪印图标 (PawPrint，与系统设置保持一致) -->
                        <Path x:Name="PetIcon"
                              Grid.Column="0"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Fill="Transparent"
                              Stroke="#1F2937"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M9 4a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M16 8a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M18 16a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"
                              VerticalAlignment="Center" />

                        <TextBlock x:Name="PetText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="显示宠物"
                                   FontSize="13"
                                   Foreground="#1F2937"
                                   VerticalAlignment="Center" />

                        <!-- Toggle Switch -->
                        <Grid Grid.Column="2"
                              Width="36"
                              Height="20"
                              VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack"
                                    CornerRadius="10"
                                    Background="#C7C7CC" />
                            <Border x:Name="SwitchThumb"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3"
                                                      ShadowDepth="1"
                                                      Opacity="0.25"
                                                      Color="#000000" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 第二行：打开主窗口 与 退出 -->
                <Grid Margin="0,4,0,0" Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 打开主窗口 -->
                    <Border x:Name="OpenWindowBtn"
                            Grid.Column="0"
                            CornerRadius="6"
                            Padding="8,0"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseEnter="OnItemMouseEnter"
                            MouseLeave="OnItemMouseLeave"
                            MouseLeftButtonUp="OnOpenWindowClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="OpenWindowIcon"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="Transparent"
                                  Stroke="#1F2937"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M15 3h6v6 M10 14 21 3 M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="OpenWindowText"
                                       Margin="8,0,0,0"
                                       Text="打开主窗口"
                                       FontSize="13"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 退出 -->
                    <Border x:Name="ExitBtn"
                            Grid.Column="2"
                            CornerRadius="6"
                            Padding="8,0"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseEnter="OnExitMouseEnter"
                            MouseLeave="OnExitMouseLeave"
                            MouseLeftButtonUp="OnExitClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="ExitIcon"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Fill="Transparent"
                                  Stroke="#1F2937"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12 2v10 M18.36 6.64A9 9 0 1 1 5.63 6.64"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="ExitText"
                                       Margin="6,0,0,0"
                                       Text="退出"
                                       FontSize="13"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>