<Window x:Class="SelfClaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SelfClaw.Desktop.Controls"
        mc:Ignorable="d"
        Title="SelfClaw"
        Width="1280"
        Height="800"
        MinWidth="1240"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon/icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ThemeMode="System">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleIconBrush"
                         Color="#FF171A1F"/>
        <SolidColorBrush x:Key="TitleIconHoverBrush"
                         Color="#FFF1F3F6"/>
        <SolidColorBrush x:Key="TitleIconPressedBrush"
                         Color="#FFE5E7EB"/>

        <Style x:Key="TitleIconPathStyle"
               TargetType="Path">
            <Setter Property="Stroke"
                    Value="{StaticResource TitleIconBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="1.35"/>
            <Setter Property="StrokeStartLineCap"
                    Value="Round"/>
            <Setter Property="StrokeEndLineCap"
                    Value="Round"/>
            <Setter Property="StrokeLineJoin"
                    Value="Round"/>
            <Setter Property="Fill"
                    Value="Transparent"/>
            <Setter Property="Stretch"
                    Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>

        <Style x:Key="TitleIconButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="MinHeight"
                    Value="30"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,0,2,0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource TitleIconHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource TitleIconPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleIconButtonStyle}">
            <Setter Property="Width"
                    Value="44"/>
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="MinHeight"
                    Value="34"/>
            <Setter Property="Margin"
                    Value="0"/>
        </Style>

        <Style x:Key="ToolIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleIconButtonStyle}">
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Margin"
                    Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame"
                Margin="0"
                CornerRadius="22"
                BorderThickness="0"
                BorderBrush="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin"
                            Value="12"/>
                    <Setter Property="CornerRadius"
                            Value="22"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}"
                                     Value="Maximized">
                            <Setter Property="Margin"
                                    Value="8"/>
                            <Setter Property="CornerRadius"
                                    Value="12"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"
                                      MinWidth="240"
                                      MaxWidth="400"/>
                    <ColumnDefinition Width="*"
                                      MinWidth="920"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="2"
                        Background="#FFFFFF"/>

                <Border Grid.Column="0"
                        x:Name="LeftSidebarHost"
                        BorderBrush="#D9DDE4"
                        BorderThickness="0,0,1,0"
                        Panel.ZIndex="1">
                    <local:LeftSidebar x:Name="LeftSidebarControl"
                                       SystemSettingsRequested="OnSystemSettingsRequested"
                                       NewConversationRequested="OnSidebarNewConversationRequested"
                                       ProjectsToggleRequested="OnSidebarProjectsToggleRequested"
                                       StandaloneConversationRequested="OnSidebarStandaloneConversationRequested"
                                       StandaloneConversationsToggleRequested="OnSidebarStandaloneConversationsToggleRequested"
                                       WorkspaceRootSelected="OnSidebarWorkspaceRootSelected"
                                       ProjectConversationRequested="OnSidebarProjectConversationRequested"
                                       ConversationSelected="OnSidebarConversationSelected"
                                       ConversationDeleteRequested="OnSidebarConversationDeleteRequested"/>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FFFFFF"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,1"/>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="Terminal"
                                    Click="OnTerminalToolButtonClick">
                                <Path Width="16"
                                      Height="16"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2.5,3.5 L13.5,3.5 L13.5,12.5 L2.5,12.5 Z M5,6.2 L7.1,8 L5,9.8 M8.6,10 L11,10"/>
                            </Button>

                            <Button Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="Files"
                                    Click="OnFileManagerToolButtonClick">
                                <Path Width="16"
                                      Height="16"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2,5.2 L5.8,5.2 L7.2,6.7 L14,6.7 L14,12.8 L2,12.8 Z M2,5.2 L2,3.7 L6.2,3.7 L7.6,5.2 L14,5.2"/>
                            </Button>

                            <Button Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="Browser"
                                    Click="OnBrowserToolButtonClick">
                                <Path Width="16"
                                      Height="16"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M8,2.2 C4.8,2.2 2.2,4.8 2.2,8 C2.2,11.2 4.8,13.8 8,13.8 C11.2,13.8 13.8,11.2 13.8,8 C13.8,4.8 11.2,2.2 8,2.2 Z M2.5,8 L13.5,8 M8,2.4 C9.25,3.9 10,5.8 10,8 C10,10.2 9.25,12.1 8,13.6 M8,2.4 C6.75,3.9 6,5.8 6,8 C6,10.2 6.75,12.1 8,13.6"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Minimize"
                                    Click="OnMinimizeButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M1.5,7 L10.5,7"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Maximize"
                                    Click="OnToggleMaximizeButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2.5,2.5 L9.5,2.5 L9.5,9.5 L2.5,9.5 Z"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Close"
                                    Click="OnCloseButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5"/>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="0"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragRegionMouseLeftButtonDown"/>

                        <Border Grid.Column="1"
                                Background="Transparent"
                                MouseLeftButtonDown="OnTitleBarDragRegionMouseLeftButtonDown"/>

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#171A1F"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.88"
                                   Text="SelfClaw"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"
                                              MinWidth="600"/>
                            <ColumnDefinition x:Name="RightPanelColumn"
                                              Width="0"
                                              MinWidth="0"
                                              MaxWidth="480"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0"
                              Grid.Column="0">
                            <webview2:WebView2 x:Name="TranscriptView"
                                               Margin="0"/>

                            <Border x:Name="WebViewFallback"
                                    Background="#FFFFFF"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="18"
                                           Foreground="#8A929E"
                                           Text="WebView2 runtime is required to render SelfClaw.&#10;Install Microsoft Edge WebView2 Runtime and restart the app."/>
                            </Border>
                        </Grid>

                        <Border x:Name="RightPanelHost"
                                Grid.Column="1"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1,0,0,0"
                                Visibility="Collapsed">
                            <local:RightPanel/>
                        </Border>
                    </Grid>
                </Grid>

                <local:SystemSettingsPanel x:Name="SystemSettingsPanelHost"
                                           Grid.ColumnSpan="2"
                                           Margin="0,35,0,0"
                                           Panel.ZIndex="30"
                                           Visibility="Collapsed"/>

                <Border x:Name="SettingsTitleBarHost"
                        Grid.ColumnSpan="2"
                        Height="35"
                        VerticalAlignment="Top"
                        Background="#FFFFFF"
                        Panel.ZIndex="31"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="OnTitleBarDragRegionMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Margin="14,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="#111827"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="设置"
                                   IsHitTestVisible="False"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,5,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="安全">
                                <Path Width="14"
                                      Height="14"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M8,2.1 L12.4,3.7 L12.4,7.1 C12.4,9.9 10.6,12.1 8,13.4 C5.4,12.1 3.6,9.9 3.6,7.1 L3.6,3.7 Z M8,5.2 L8,8.1 M8,10.2 L8.05,10.2"/>
                            </Button>

                            <Button Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="帮助">
                                <Path Width="14"
                                      Height="14"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M8,2.4 C4.9,2.4 2.4,4.9 2.4,8 C2.4,11.1 4.9,13.6 8,13.6 C11.1,13.6 13.6,11.1 13.6,8 C13.6,4.9 11.1,2.4 8,2.4 Z M6.4,6.2 C6.7,5.3 7.4,4.9 8.3,4.9 C9.3,4.9 10,5.5 10,6.4 C10,7.7 8.3,8 8.3,9.2 M8.3,11.1 L8.35,11.1"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Minimize"
                                    Click="OnMinimizeButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M1.5,7 L10.5,7"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Maximize"
                                    Click="OnToggleMaximizeButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2.5,2.5 L9.5,2.5 L9.5,9.5 L2.5,9.5 Z"/>
                            </Button>

                            <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                    ToolTip="Close"
                                    Click="OnCloseButtonClick">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource TitleIconPathStyle}"
                                      Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
