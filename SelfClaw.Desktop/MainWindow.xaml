<Window x:Class="SelfClaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="SelfClaw"
        Width="1480"
        Height="920"
        MinWidth="1240"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        ThemeMode="System">
    <Grid Background="{StaticResource WindowCanvasBrush}">
        <webview2:WebView2 x:Name="TranscriptView"
                           Margin="0"
/>

        <Border x:Name="WebViewFallback"
                Background="{StaticResource WindowCanvasBrush}"
                Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="18"
                       Foreground="{StaticResource SubtleForegroundBrush}"
                       Text="WebView2 runtime is required to render SelfClaw.&#10;Install Microsoft Edge WebView2 Runtime and restart the app." />
        </Border>
    </Grid>
</Window>

