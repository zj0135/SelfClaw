<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon\icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <InternalsVisibleTo Include="SelfClaw.Tests" />
    <ProjectReference Include="..\SelfClaw.Core\SelfClaw.Core.csproj" />
    <ProjectReference Include="..\SelfClaw.Infrastructure\SelfClaw.Infrastructure.csproj" />
    <Resource Include="Assets\icon\icon.ico" />
    <None Update="Assets\TranscriptVue\*;Assets\TranscriptVue\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\skills\*;Assets\skills\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SelfClaw.TranscriptVue\assets\pets\**\*">
      <Link>Assets\pets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="runtimes\win-x64\native\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyProtectedDataAssembly" AfterTargets="Build" Condition="Exists('$(PkgSystem_Security_Cryptography_ProtectedData)\lib\net10.0\System.Security.Cryptography.ProtectedData.dll')">
    <Copy SourceFiles="$(PkgSystem_Security_Cryptography_ProtectedData)\lib\net10.0\System.Security.Cryptography.ProtectedData.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="SyncTranscriptVueAssets" AfterTargets="Build">
    <ItemGroup>
      <TranscriptVueAsset Include="$(MSBuildProjectDirectory)\Assets\TranscriptVue\*;$(MSBuildProjectDirectory)\Assets\TranscriptVue\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(TranscriptVueAsset)" DestinationFiles="@(TranscriptVueAsset->'$(OutDir)Assets\TranscriptVue\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="SyncSkillAssets" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\Assets\skills')">
    <ItemGroup>
      <SkillAsset Include="$(MSBuildProjectDirectory)\Assets\skills\*;$(MSBuildProjectDirectory)\Assets\skills\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(SkillAsset)" DestinationFiles="@(SkillAsset->'$(OutDir)Assets\skills\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="SyncPetAssets" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\SelfClaw.TranscriptVue\assets\pets')">
    <ItemGroup>
      <PetAsset Include="$(MSBuildProjectDirectory)\..\SelfClaw.TranscriptVue\assets\pets\*;$(MSBuildProjectDirectory)\..\SelfClaw.TranscriptVue\assets\pets\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PetAsset)" DestinationFiles="@(PetAsset->'$(OutDir)Assets\pets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
</Project>
